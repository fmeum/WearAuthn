<?xml version="1.0" encoding="utf-8"?>
<!--
  Wear Material 3 Expressive list: 5.2% side margin, 16.64% top margin, items fill the width
  and hug their content. The fading edge keeps content from being sliced by the round bezel.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_background"
    android:clipToPadding="false"
    android:fadingEdge="vertical"
    android:fadingEdgeLength="28dp"
    android:fillViewport="true"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="38dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/tile_title"
            android:textColor="@color/m3_on_surface"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/devices_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.02"
            android:text="@string/main_section_devices"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/device_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/more_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.02"
            android:text="@string/main_section_more"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/action_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
