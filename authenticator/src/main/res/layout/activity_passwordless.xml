<?xml version="1.0" encoding="utf-8"?>
<!--
  Passwordless mode: title, one short paragraph, one switch pill, one footnote.
  Everything that matters sits above the 60 % line of the circle, where a 225dp round
  screen still has ~200dp of usable width and the footnote never gets cut by the arc.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_background"
    android:fillViewport="true"
    android:fadingEdge="vertical"
    android:fadingEdgeLength="24dp"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none"
    tools:context="me.henneke.wearauthn.ui.main.PasswordlessModeActivity">

    <requestFocus />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="34dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/passwordless_screen_title"
            android:textColor="@color/m3_on_surface"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/descriptionView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/passwordless_screen_description"
            android:textAlignment="center"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/switchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_item_pressed"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/stateChip"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_primary">

                <ImageView
                    android:id="@+id/stateIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_btn_lock"
                    android:tint="@color/m3_on_primary_container" />
            </FrameLayout>

            <TextView
                android:id="@+id/switchLabelView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/m3_on_surface"
                android:textSize="15sp"
                tools:text="已开启" />

            <FrameLayout
                android:id="@+id/switchTrack"
                android:layout_width="50dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_switch_track">

                <View
                    android:id="@+id/switchThumb"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_switch_thumb" />
            </FrameLayout>
        </LinearLayout>



    </LinearLayout>
</ScrollView>
